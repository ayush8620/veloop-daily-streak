NODE_ENV=development
PORT=5000
# local: mongodb://127.0.0.1:27017/veloop?replicaSet=rs0  (transactions need a replica set; Atlas has one)
MONGO_URI=
# at least 32 random chars, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
# enables /api/dev/time-travel outside production
ENABLE_DEV_TOOLS=true
RATE_LIMIT_CLAIM_PER_MIN=10
RATE_LIMIT_AUTH_PER_15MIN=20
RATE_LIMIT_API_PER_MIN=120
DEMO_EMAIL=demo@veloop.test
DEMO_PASSWORD=Demo@12345
